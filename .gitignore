.DS_Store
ytbeatmakercues-*.zip

# Keep the pinned runtime distribution available in GitHub source downloads.
# Ignore other installed dependencies and npm's generated module metadata.
node_modules/*
!node_modules/signalsmith-stretch/
node_modules/signalsmith-stretch/*
!node_modules/signalsmith-stretch/SignalsmithStretch.mjs
!node_modules/signalsmith-stretch/package.json
!node_modules/signalsmith-stretch/README.md

# Optional local model fixtures are never committed or packaged.
# Runtime model installation uses extension-origin OPFS and pinned Hugging Face bytes.
addons/stems/model/
